DirectoryIndex index.html
Options -Indexes

# Enable rewrite for prerendered static pages and SPA fallback
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Keep ACME/Plesk certificate challenges reachable
  RewriteRule ^\.well-known/ - [L]

  # Let actual files and prerendered directories be served
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Otherwise serve the prerendered home page
  RewriteRule ^ /index.html [L,QSA]
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "same-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header set X-XSS-Protection "1; mode=block"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

# MIME types for static hosting
<IfModule mod_mime.c>
  AddType text/css .css
  AddType application/javascript .js
  AddType video/mp4 .mp4
  AddType application/xml .xml
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
</IfModule>

# Caching for static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Deny access to dotfiles, except .well-known for certificate challenges
<FilesMatch "^\.(?!well-known)">
  Require all denied
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
